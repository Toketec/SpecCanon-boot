#!/usr/bin/env bash
# ============================================================================
# spec-rocket — SpecRocket CLI
# ============================================================================
# 用法:
#   /spec-rocket init [项目名]     → 在当前目录创建空壳项目
#   /spec-rocket brainstorm       → 引导你填充产品文档 + 创建 sprint
#   /spec-rocket migrate          → 在当前项目嵌入 SpecRocket 骨架
#   /spec-rocket preview          → 生成项目可视化预览页
#
# 一行命令（无需克隆仓库）:
#   curl -fsSL https://raw.githubusercontent.com/Toketec/SpecRocket/main/spec-rocket | bash -s init
#   curl ... | bash -s brainstorm
#   curl ... | bash -s migrate
#   curl ... | bash -s preview
# ============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; R='\033[0;31m'; N='\033[0m'

usage() {
    echo -e "${C}SpecRocket — 快速创建规范项目${N}"
    echo ""
    echo "用法: spec-rocket <子命令>"
    echo ""
    echo "  子命令:"
    echo "    init [项目名]    建空壳 + git init"
    echo "    brainstorm      引导你填充产品文档 + 创建 sprint"
    echo "    migrate         嵌入骨架到现有项目"
    echo "    preview         生成项目可视化预览页"
    echo ""
    echo "示例:"
    echo "  curl ... | bash -s init"
    echo "  curl ... | bash -s brainstorm"
    echo "  curl ... | bash -s migrate"
    echo "  curl ... | bash -s preview"
}

CMD="${1:-}"; shift 2>/dev/null || true

case "$CMD" in
    init)
        exec "$SCRIPT_DIR/scripts/init.sh" "$@"
        ;;
    brainstorm)
        exec "$SCRIPT_DIR/scripts/brainstorm.sh" "$@"
        ;;
    migrate)
        exec "$SCRIPT_DIR/scripts/migrate.sh" "$@"
        ;;
    preview)
        exec "$SCRIPT_DIR/scripts/preview.sh" "$@"
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        echo -e "${R}未知子命令: $CMD${N}"
        usage
        exit 1
        ;;
esac
